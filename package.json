{
  "name": "ballkingdom-static-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:your-game": "node --test tests/your-game.test.mjs",
    "test:your-game:browser": "playwright test tests/your-game-browser.spec.mjs",
    "test:storefront:unit": "node --test tests/product-catalog.test.mjs tests/product-artifact-hosting.test.mjs tests/storefront-html.test.mjs",
    "test:storefront:browser": "playwright test tests/storefront-browser.spec.mjs",
    "test:storefront": "npm run test:storefront:unit && npm run test:storefront:browser",
    "hi:ingest": "node home-inspection-guide/scripts/ingest-images.mjs",
    "hi:add": "node home-inspection-guide/scripts/add-thread-images.mjs",
    "hi:build": "node home-inspection-guide/scripts/build-guide.mjs && cp home-inspection-guide/index.html home-inspection-guide/full-study-guide.html",
    "hi:freebie": "node home-inspection-guide/scripts/build-freebie.mjs",
    "hi:verify-companion": "node home-inspection-guide/scripts/verify-companion-link.mjs",
    "hi:pdf": "node home-inspection-guide/scripts/build-pdf.mjs",
    "hi:dev": "python3 -m http.server 4173",
    "hi:all": "npm run hi:ingest && npm run hi:build && npm run hi:pdf"
  },
  "dependencies": {
    "@playwright/test": "^1.45.0",
    "pdf-lib": "^1.17.1",
    "sharp": "0.35.4"
  }
}
