{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "codebase": "ballkingdom-integrations"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "public",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "storage.rules",
        "firestore.indexes.json",
        ".firebaserc",
        ".git/**",
        ".firebase/**",
        ".playwright-cli/**",
        "**/.*",
        "**/node_modules/**",
        "backend/**",
        "functions/**",
        "tests/**",
        "docs/**",
        "output/**",
        "test-results/**",
        "playwright-report/**",
        "playwright.config.mjs",
        "video/**",
        "MIGRATION.md",
        "README.md",
        "FOUNDER_BIO.md",
        "package.json",
        "package-lock.json",
        "assets/**/*.bak",
        "home-inspection-guide/scripts/**",
        "home-inspection-guide/src/**",
        "home-inspection-guide/input/**",
        "home-inspection-guide/audit/**",
        "home-inspection-guide/README.md",
        "hosting/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, must-revalidate"
            }
          ]
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    },
    {
      "site": "theballerskingdom-redirect",
      "public": "hosting/theballerskingdom-redirect/public",
      "ignore": [
        "firebase.json",
        "firestore.rules",
        "storage.rules",
        "**/.*"
      ],
      "redirects": [
        {
          "source": "**",
          "destination": "https://ballkingdom.com/",
          "type": 301
        }
      ]
    }
  ]
}
