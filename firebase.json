{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "codebase": "ballkingdom-integrations"
  },
  "firestore": {
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "public",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".git/**",
        ".firebase/**",
        ".playwright-cli/**",
        "**/.*",
        "**/node_modules/**",
        "backend/**",
        "functions/**",
        "tests/**",
        "docs/**",
        "output/**",
        "test-results/**",
        "playwright-report/**",
        "playwright.config.mjs",
        "video/**",
        "MIGRATION.md",
        "README.md",
        "FOUNDER_BIO.md",
        "package.json",
        "package-lock.json",
        "assets/**/*.bak",
        "home-inspection-guide/scripts/**",
        "home-inspection-guide/src/**",
        "home-inspection-guide/input/**",
        "home-inspection-guide/audit/**",
        "home-inspection-guide/README.md"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            }
          ]
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    }
  ]
}
